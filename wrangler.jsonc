{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datafog-lance-context",
  "main": "cloudflare/worker.js",
  "account_id": "5af65814b462b37cf1e5bba7d499c3a5",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "ui/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application"},
  "containers": [{"name": "datafog-lance-context-engine", "class_name": "LanceDemoContainer", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 1}],
  "durable_objects": {"bindings": [{"name": "DEMO", "class_name": "LanceDemoContainer"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LanceDemoContainer"]}],
  "observability": {"enabled": false},
  "vars": {"CONTAINER_REVISION": "demo-v1"}
}
