{
  "name": "datafog-lance-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real Lance context exports reviewed with DataFog Core",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix ui run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:generator": "wrangler deploy --config wrangler.generator.jsonc",
    "generate": "python3 scripts/generate_dataset.py",
    "test:worker": "node --test cloudflare/*.test.js",
    "test:generator": "python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {"@cloudflare/containers": "0.3.7"},
  "devDependencies": {"wrangler": "4.156.0"}
}
